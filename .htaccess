# ==============================================================
# CONFIGURATION APACHE & REWRITING POUR WIKY HOLDING
# 100% Compatible InfinityFree & Local (WAMP / Laragon)
# ==============================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Bloquer l'accès direct aux fichiers sensibles
    RewriteRule ^(database\.sql|database\.sqlite|\.git|sqldirecte\.sql) - [F,L,NC]

    # Ne pas réécrire si le fichier ou répertoire existe réellement
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirection vers le contrôleur frontal
    RewriteRule ^(.*)$ index.php?page=$1 [QSA,L]
</IfModule>
